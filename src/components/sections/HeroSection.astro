<section
  id="heroSection"
  class="relative w-screen h-screen max-h-[1000px] bg-gray-300 flex justify-center overflow-hidden indexSection"
>
  <div id="container"
    class="w-full max-w-[1100px] h-full max-h-[1000px] flex md:justify-start justify-center px-5 md:px-20 lg:px-10 pt-12"
  >
    <div class="relative w-auto h-auto z-10">
      <img class="w-[90vw] md:w-[55vw] max-w-[650px] tittle" src="/iramLetras.svg" />
      <span class="text-[10px] md:text-[1rem]"
        >CREATIVO / DISRUPTIVO / FUNCIONAL</span
      >
      <div class="w-full">
        <img
          alt="Picture"
          class="w-[65vw] max-w-[510px] md:w-[45vw] isolate z-10"
          src="/Retrato.jpg"
        />

        <div class="flex flex-row gap-1">
          <span id="webSpan" style="display: block;" class="text-[12px] md:text-[15px] font-bold">web</span>
          <span id="appSpan" style="display: none;" class="text-[12px] md:text-[15px] font-bold">app</span>
          <span class="text-[12px] md:text-[15px]">{"</developer>"}</span>
        </div>

        <img
          alt="squares"
          class="w-[2rem] py-1"
          src="/projects-svgrepo-com.svg"
        />
      </div>

      <img
        alt="arrow"
        class="w-[2rem] md:w-[3rem] absolute right-5 min-[500px]:left-0 bottom-7"
        src="/arrowDown.svg"
      />

    </div>
  </div>

<div
  class="absolute z-20 w-[80vw] max-w-[600px] min-[435px]:w-[60vw] min-[435px]:scale-x-[-1] min-[435px]:scale-y-[-1] min-[435px]:right-0 min-[435px]:left-auto left-0 bottom-10 liquidCristalImage"
>
  <img src="/LiquidGlassSinFondo copia.png" />
</div>
</section>

<script>
import { animate } from "motion/mini"

const webSpan = document.getElementById("webSpan")
const appSpan = document.getElementById("appSpan")
const inAnimation = { opacity: [0, 1], transform: ['translateY(20px)', 'translateY(0)'] }
const outAnimation = { opacity: [1, 0], transform: ['translateY(0)', 'translateY(-20px)'] }
const duration = { duration: 0.05 }

let isWebVisible = true

async function spanChange() {
    if (!webSpan || !appSpan) return

    if (isWebVisible) {
        await animate(webSpan, outAnimation, duration).finished
        webSpan.style.display = "none"
        
        appSpan.style.display = "block"
        animate(appSpan, inAnimation, duration)
        
        isWebVisible = false
    } 
    
    else {
        await animate(appSpan, outAnimation, duration).finished
        appSpan.style.display = "none"
        
        webSpan.style.display = "block"
        animate(webSpan, inAnimation, duration)
        
        isWebVisible = true
    }
    
    setTimeout(spanChange, 2500)
}

spanChange()
</script>
