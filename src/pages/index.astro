---
import HeroSection from "../components/sections/HeroSection.astro";
import WhoIAmSection from "../components/sections/WhoIAmSection.astro";
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar/Navbar.astro';
import ServicesSection from "../components/sections/ServicesSection.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import FooterLayout from "../components/shared/FooterLayout.astro";

---

<Layout>
	<Navbar />
	<HeroSection />
	<WhoIAmSection />
	<ServicesSection />
	<ProjectsSection />
	<FooterLayout>
		<ContactSection />
	</FooterLayout>
</Layout>

<script>
	import { animate} from "motion/mini"
	import { inView } from "motion"

	const tittles = document.querySelectorAll(".tittle")

	inView(tittles, (element) => {
		animate(
			element, 
			{ opacity: [0, 1], x: [-100, 0] }, 
			{ duration: 0.5 }
		)

		return () => { animate(element,
			{ opacity : 0 },
			)
		}
	}
)
    const liquidCristalImages = document.querySelectorAll(".liquidCristalImage")

	inView(liquidCristalImages, (element) => {
		animate(
			element, 
			{ transform: ['translateY(-100px)', 'translateY(0)'] }, 
			{ duration: 0.5, bounce : 0 }
		)

		return () => {animate(element,
			{ transform: ['translateY(0)', 'translateY(-100px)'] },
			)
		}
	})

	const serviceCards = document.querySelectorAll(".serviceCard")

	inView(serviceCards, (element) => {
		animate(
			element, 
			{ transform : ['translateX(-200px)', 'translateX(0)'] }, 
			{ duration: 0.2 },
		)

		return () => { animate(element,
			{ transform: ['translateX(0)', 'translateX(-100px)'] }, 
			)
		}
	})


</script>
