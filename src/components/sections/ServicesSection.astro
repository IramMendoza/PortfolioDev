---
import ServiceCard from "../shared/ServiceCard.astro"
---

<section
  class="w-screen h-auto bg-red-500 relative flex justify-center indexSection"
>
  <div class="max-w-[1150px] w-[90vw] h-auto relative flex flex-col py-10 lg:flex-row">
    <div class="w-full h-auto lg:max-w-[30vw]">
      <h2
        id="title-section"
        class="w-full lg:max-w-[40vw] lg:absolute lg:sticky lg:top-30 text-black text-[4rem] md:text-[7rem] text-shadow-lg/20 font-extrabold text-center tittle">
        SERVICES
      </h2>
    </div>

    <div
      id="cardsContainer"
      class="w-full flex flex-col items-center gap-5 md:gap-10 px-4 h-full"
    >
      <ServiceCard
        image="/mac.jpg"
        service="WEB DESIGN"
        description="Diseño de sitios web modernos y responsivos."
        extendedDescription="Lorem ipsum dolor sit amet, consectetur adipiscing elit. lorem ipsum dolor sit amet, consectetur adipiscing elit."
        color="black"
        id="1"
      />
      <ServiceCard
        image="/mac.jpg"
        service="App Development"
        description="Desarrollo de aplicaciones móviles y web."
        extendedDescription="Lorem ipsum dolor sit amet, consectetur adipiscing elit. lorem ipsum dolor sit amet, consectetur adipiscing elit."
        color="white"
        id="2"
      />
      <ServiceCard
        image="/mac.jpg"
        service="SEO Optimization"
        description="lore ipsum dolor sit amet, consectetur adipiscing elit. lorem ipsum dolor sit amet, consectetur adipiscing elit."
        extendedDescription="Lorem ipsum dolor sit amet, consectetur adipiscing elit. lorem ipsum dolor sit amet, consectetur adipiscing elit."
        color="black"
        id="3"
      />
      <ServiceCard
        image="/mac.jpg"
        service="App Development"
        description="lore ipsum dolor sit amet, consectetur adipiscing elit. lorem ipsum dolor sit amet, consectetur adipiscing elit."
        extendedDescription="Lorem ipsum dolor sit amet, consectetur adipiscing elit. lorem ipsum dolor sit amet, consectetur adipiscing elit."
        color="white"
        id="4"
      />
    </div>
  </div>
</section>

<script>
  const titleEl = document.getElementById("title-section");
  const updateTitle = () => {
    const width = window.innerWidth;
    if (titleEl) {
      titleEl.textContent = width < 900 ? "SERVICIOS" : "SERV-ICIOS";
    }
  };

  updateTitle();
  window.addEventListener("resize", updateTitle)
</script>
