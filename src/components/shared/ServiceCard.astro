---
interface Props {
  image: string;
  service: string;
  description: string;
  color : string;
}

const { image, service, description, color } = Astro.props;

/// El span debe tener los colores tambien invertidos, ya que su elemento padre fuerza el inversion del color tambien en el texto

---

<div class={`flex flex-col md:flex-row w-auto max-w-[550px] shadow-xl/20 p-4 serviceCard`} style={`background-color: ${color}`}>
  <div class="w-full flex justify-center items-center">
    <img src={image} class="w-full md:w-[25vw] max-w-[250px] object-cover" />
  </div>

  <div class="flex flex-col items-center md:items-start justify-between px-4 py-2 h-full w-full">
    <p class={`font-bold text-xl md:text-2xl`} style={`color: ${color}; filter:invert(1) `}>
      {service}
    </p>

    <div class="max-w-[250px] w-full">
        <p class={`text-${color} invert text-sm md:text-[10px] mb-auto py-2 md:my-2 leading-relaxed`}>
        {description}
    </p>

    </div>
    <a class={`invert w-fit px-4 py-2 mt-auto`} style={`background-color: ${color}`}>
      <span class={`text-${color} invert text-sm md:text-base`}>
        Ver más →
      </span>
    </a>
  </div>
</div>