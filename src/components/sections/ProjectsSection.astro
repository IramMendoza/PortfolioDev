<script type="module">
    function parallaxScroll({ containerId, columns }) {
        const container = document.getElementById(containerId);
        const els = columns.map(id => document.getElementById(id));
        let startScroll = 0;
        let isInView = false;

        const observer = new IntersectionObserver(([entry]) => {
            isInView = entry.isIntersecting;

            if (isInView) {
                startScroll = window.scrollY;
                window.addEventListener("scroll", onScroll);
            } else {
                els.forEach(el => el && (el.style.transform = 'translateY(0px)'));
                window.removeEventListener("scroll", onScroll);
            }
        });

        const onScroll = () => {
            if (!isInView) return;
            const y = window.scrollY - startScroll;

            els.forEach((el, i) => {
                if (!el) return;
                const speed = [-0.4, 0.4, -0.3][i]; // ajusta según orden
                el.style.transform = `translateY(${y * speed}px)`;
            });
        };

        observer.observe(container);
        window.addEventListener("beforeunload", () => window.removeEventListener("scroll", onScroll));
    }

    // ✅ Llamada simple
    parallaxScroll({
        containerId: "projectsContainer",
        columns: ["leftColumn", "centerColumn", "rightColumn"]
    });
</script>