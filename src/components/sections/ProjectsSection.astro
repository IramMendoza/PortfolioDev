
<section id="projectsContainer" class="w-screen h-screen max-h-[800px] flex justify-center bg-black overflow-hidden darkSection">
    <div class="h-full w-full flex justify-center items-center md:gap-5">
        <div class="column sideColumn mb-[300vh]">
            <img class="projectCard" src="/Projects/redlights02.png"/>
            <img class="projectCard" src="/Projects/azfood02.png"/>
            <img class="projectCard" src="/Projects/azfood01.png"/>
            <img class="projectCard" src="/Projects/redlights02.png"/>
            <img class="projectCard" src="/Projects/azfood02.png"/>
            <img class="projectCard" src="/Projects/azfood01.png"/>
        </div>
        <div id="centerColumn" class="column">
            <img class="projectCard" src="/Projects/azfood03.png"/>
            <img class="projectCard" src="/Projects/redlights03.png"/>
            <img class="projectCard" src="/Projects/adhiccsa02.png"/>
            <img class="projectCard" src="/Projects/azfood03.png"/>
            <img class="projectCard" src="/Projects/redlights03.png"/>
            <img class="projectCard" src="/Projects/adhiccsa02.png"/>
        </div>
        <div class="hidden md:block column sideColumn mb-[300vh]">
            <img class="projectCard" src="/Projects/redlights04.png"/>
            <img class="projectCard" src="/Projects/adhiccsa01.png"/>
            <img class="projectCard" src="/Projects/redlights05.png"/>
            <img class="projectCard" src="/Projects/redlights04.png"/>
            <img class="projectCard" src="/Projects/adhiccsa01.png"/>
            <img class="projectCard" src="/Projects/redlights05.png"/>
        </div>
    </div>
</section>

<style>

    .projectCard {
    width: 100%;
    margin-bottom: 0.5rem;
    border-radius: 8px;
    object-fit: cover;
}

@media (min-width: 640px) {
    .projectCard {
        max-width: 200px;
        height: 250px;
        margin-bottom: 0.75rem;
    }
}

@media (min-width: 768px) {
    .projectCard {
        max-width: 250px;
        height: 320px;
        margin-bottom: 1rem;
    }
}

@media (min-width: 1024px) {
    .projectCard {
        max-width: 250px;
        height: 320px;
        margin-bottom: 1.25rem;
    }
}

@media (min-width: 1280px) {
    .projectCard {
        max-width: 280px;
        height: 360px;
        margin-bottom: 1.5rem;
    }
}

    .column {
        width: full;
        height: 130vh;
    }
</style>

<script>
    import { scroll, animate } from "motion"

    const scrollContainer = document.getElementById("projectsContainer")
    const centerColumn = document.getElementById("centerColumn")
    const sideColumn = document.querySelectorAll(".sideColumn")

    if (centerColumn && sideColumn && scrollContainer)

    scroll((progress : any ) => {
        animate(centerColumn, { y : progress * -800 }, { bounce : 0 })
        animate(sideColumn, { y : progress * 1200 }, { bounce : 0 })
        }, { target : scrollContainer, offset: ["start end", "end start"] }
    )
    
</script>