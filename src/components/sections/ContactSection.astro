<section>
    <h2 class=" text-[3rem] md:text-[10rem] pt-10 font-extrabold text-center">
        CONTACT
    </h2>
    <div class="flex flex-col items-center gap-5 px-4 h-full overflow-y-auto">
        <p class="text-center">Feel free to reach out for collaborations or just a friendly chat!</p>
        <form class="w-full max-w-md">
            <input type="text" placeholder="Your Name" class="w-full p-2 mb-4 border rounded" required />
            <input type="email" placeholder="Your Email" class="w-full p-2 mb-4 border rounded" required />
            <textarea placeholder="Your Message" class="w-full p-2 mb-4 border rounded" rows="4" required></textarea>
            <button type="submit" class="bg-black text-white p-2 rounded">Send Message</button>
        </form>
</section>